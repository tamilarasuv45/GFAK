# ==============================================================================
# SKYWARD AMBITION - ENVIRONMENT SETTINGS
# ==============================================================================

PORT=3000

# ------------------------------------------------------------------------------
# EMAIL NOTIFICATION SETTINGS (OPTIONAL FOR SERVER NODEMAILER)
# ------------------------------------------------------------------------------
# If you want the local Node server to automatically forward every birthday salute
# to your email inbox via Nodemailer, configure your Gmail / SMTP details below:

RECIPIENT_EMAIL=your_email@gmail.com

# SMTP Provider (e.g., Gmail):
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
